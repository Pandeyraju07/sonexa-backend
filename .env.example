# Copy to .env and fill real values. Never commit .env.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://mysqldb:3306/sonexa_db?useSSL=true&requireSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=sonexa_user
SPRING_DATASOURCE_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

JWT_SECRET=replace-with-a-random-64-character-secret

SONEXA_MEDIA_PUBLIC_BASE_URL=https://api.sonexa.app
SONEXA_CORS_ORIGINS=https://sonexa.app,https://www.sonexa.app
SONEXA_MAIL_USERNAME=
SONEXA_MAIL_PASSWORD=
YOUTUBE_API_KEY=
SONEXA_MUSIXMATCH_APIKEY=
